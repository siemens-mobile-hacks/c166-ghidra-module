<?xml version="1.0" encoding="UTF-8"?>

<!--
    TASKING C166/ST10 Classic ABI, large memory model.

    This compiler spec intentionally lives beside, rather than replacing,
    c166.cspec.  Existing programs using compiler ID "tasking" retain their
    original data organization and calling conventions.
-->
<compiler_spec>
    <stackpointer register="r0" space="ram" growth="negative"/>

    <!-- TASKING Classic C166 data types, large model. -->
    <data_organization>
        <absolute_max_alignment value="2"/>
        <machine_alignment value="2"/>
        <default_alignment value="1"/>
        <default_pointer_alignment value="2"/>
        <pointer_size value="4"/>
        <char_type signed="true"/>
        <char_size value="1"/>
        <wchar_size value="2"/>
        <short_size value="2"/>
        <integer_size value="2"/>
        <long_size value="4"/>
        <long_long_size value="8"/>
        <float_size value="4"/>
        <double_size value="8"/>
        <long_double_size value="8"/>
        <size_alignment_map>
            <entry size="1" alignment="1"/>
            <entry size="2" alignment="2"/>
            <entry size="4" alignment="2"/>
            <entry size="8" alignment="2"/>
        </size_alignment_map>
    </data_organization>

    <callfixup name="call_far_indirect">
        <target name="__call_far_indirect"/>
        <pcode>
            <body><![CDATA[
            local callAddr:3 = (zext(r5) << 16) | zext(r4);
            call [callAddr];
            ]]></body>
        </pcode>
    </callfixup>

    <!--
        TASKING 32-bit integer expression helpers use R5:R4 for the left
        operand/result and R11:R10 for the right operand.  They do not use the
        ordinary C parameter registers R12-R15.
    -->
    <callfixup name="c166_tasking_mulu4">
        <pcode>
            <body><![CDATA[
            local left:4 = (zext(r5) << 16) | zext(r4);
            local right:4 = (zext(r11) << 16) | zext(r10);
            local result:4 = left * right;
            r4 = trunc(result);
            r5 = trunc(result >> 16);
            ]]></body>
        </pcode>
    </callfixup>

    <callfixup name="c166_tasking_divu4">
        <pcode>
            <body><![CDATA[
            local dividend:4 = (zext(r5) << 16) | zext(r4);
            local divisor:4 = (zext(r11) << 16) | zext(r10);
            local result:4 = dividend / divisor;
            r4 = trunc(result);
            r5 = trunc(result >> 16);
            ]]></body>
        </pcode>
    </callfixup>

    <callfixup name="c166_tasking_modu4">
        <pcode>
            <body><![CDATA[
            local dividend:4 = (zext(r5) << 16) | zext(r4);
            local divisor:4 = (zext(r11) << 16) | zext(r10);
            local result:4 = dividend % divisor;
            r4 = trunc(result);
            r5 = trunc(result >> 16);
            ]]></body>
        </pcode>
    </callfixup>

    <!--
        TASKING's double support routines move the software user-stack pointer
        themselves.  Treating them as ordinary calls hides both the R0 change
        and the copied value from the decompiler, leaving later double
        arguments apparently uninitialized.
    -->
    <callfixup name="c166_tasking_load8n">
        <pcode>
            <body><![CDATA[
            local source:2 = r4;
            local word0:2 = *:2 source;
            source = source + 2;
            local word1:2 = *:2 source;
            source = source + 2;
            local word2:2 = *:2 source;
            source = source + 2;
            local word3:2 = *:2 source;
            r0 = r0 - 8;
            local destination:2 = r0;
            *:2 destination = word0;
            destination = destination + 2;
            *:2 destination = word1;
            destination = destination + 2;
            *:2 destination = word2;
            destination = destination + 2;
            *:2 destination = word3;
            r4 = source;
            r10 = r0;
            ]]></body>
        </pcode>
    </callfixup>

    <callfixup name="c166_tasking_load8f">
        <pcode>
            <body><![CDATA[
            local source_offset:2 = r4;
            local source:3 = (zext(r5 & 0x3ff) << 14) | zext(source_offset & 0x3fff);
            local word0:2 = *[ram]:2 source;
            source = source + 2;
            local word1:2 = *[ram]:2 source;
            source = source + 2;
            local word2:2 = *[ram]:2 source;
            source = source + 2;
            local word3:2 = *[ram]:2 source;
            r0 = r0 - 8;
            local destination:2 = r0;
            *:2 destination = word0;
            destination = destination + 2;
            *:2 destination = word1;
            destination = destination + 2;
            *:2 destination = word2;
            destination = destination + 2;
            *:2 destination = word3;
            DPP0 = r5;
            r4 = source_offset + 6;
            r10 = r0;
            ]]></body>
        </pcode>
    </callfixup>

    <callfixup name="c166_tasking_store8f">
        <pcode>
            <body><![CDATA[
            local source:2 = r10;
            local word0:2 = *:2 source;
            source = source + 2;
            local word1:2 = *:2 source;
            source = source + 2;
            local word2:2 = *:2 source;
            source = source + 2;
            local word3:2 = *:2 source;
            local destination_offset:2 = r4;
            local destination:3 =
                (zext(r5 & 0x3ff) << 14) | zext(destination_offset & 0x3fff);
            *[ram]:2 destination = word0;
            destination = destination + 2;
            *[ram]:2 destination = word1;
            destination = destination + 2;
            *[ram]:2 destination = word2;
            destination = destination + 2;
            *[ram]:2 destination = word3;
            DPP0 = r5;
            r4 = destination_offset + 6;
            r10 = source;
            ]]></body>
        </pcode>
    </callfixup>

    <callfixup name="c166_tasking_store8n">
        <pcode>
            <body><![CDATA[
            local source:2 = r10;
            local word0:2 = *:2 source;
            source = source + 2;
            local word1:2 = *:2 source;
            source = source + 2;
            local word2:2 = *:2 source;
            source = source + 2;
            local word3:2 = *:2 source;
            local destination:2 = r4;
            *:2 destination = word0;
            destination = destination + 2;
            *:2 destination = word1;
            destination = destination + 2;
            *:2 destination = word2;
            destination = destination + 2;
            *:2 destination = word3;
            r10 = source;
            r4 = destination;
            ]]></body>
        </pcode>
    </callfixup>

    <callfixup name="c166_tasking_cif28r">
        <pcode>
            <body><![CDATA[
            local integer:8 = sext(r4);
            local value:8 = int2float(integer);
            r0 = r0 - 8;
            r10 = r0;
            *:8 r10 = value;
            ]]></body>
        </pcode>
    </callfixup>

    <callfixup name="c166_tasking_cfi82r">
        <pcode>
            <body><![CDATA[
            local value:8 = *:8 r10;
            r4 = trunc(value);
            ]]></body>
        </pcode>
    </callfixup>

    <callfixup name="c166_tasking_adf8r">
        <pcode>
            <body><![CDATA[
            local left:8 = *:8 r10;
            local right:8 = *:8 r11;
            *:8 r10 = left f+ right;
            ]]></body>
        </pcode>
    </callfixup>

    <callfixup name="c166_tasking_sbf8r">
        <pcode>
            <body><![CDATA[
            local left:8 = *:8 r10;
            local right:8 = *:8 r11;
            *:8 r10 = left f- right;
            ]]></body>
        </pcode>
    </callfixup>

    <callfixup name="c166_tasking_mlf8r">
        <pcode>
            <body><![CDATA[
            local left:8 = *:8 r10;
            local right:8 = *:8 r11;
            *:8 r10 = left f* right;
            ]]></body>
        </pcode>
    </callfixup>

    <callfixup name="c166_tasking_dvf8r">
        <pcode>
            <body><![CDATA[
            local left:8 = *:8 r10;
            local right:8 = *:8 r11;
            *:8 r10 = left f/ right;
            ]]></body>
        </pcode>
    </callfixup>

    <callfixup name="c166_tasking_ngf8r">
        <pcode>
            <body><![CDATA[
            local value:8 = *:8 r10;
            local zero:8 = int2float(0:8);
            *:8 r10 = zero f- value;
            ]]></body>
        </pcode>
    </callfixup>

    <callfixup name="c166_tasking_swap8r">
        <pcode>
            <body><![CDATA[
            local left:8 = *:8 r10;
            local right:8 = *:8 r11;
            *:8 r10 = right;
            *:8 r11 = left;
            ]]></body>
        </pcode>
    </callfixup>

    <callotherfixup targetop="GetPagedOffset">
        <pcode dynamic="true">
            <input name="mem" size="2"/>
            <output name="off" size="3"/>
        </pcode>
    </callotherfixup>

    <callotherfixup targetop="c166_switch_load">
        <pcode dynamic="true">
            <input name="ptr" size="2"/>
            <output name="val" size="2"/>
        </pcode>
    </callotherfixup>

    <callotherfixup targetop="c166_reg_offset_addr">
        <pcode dynamic="true">
            <input name="reg" size="2"/>
            <input name="offset" size="2"/>
            <output name="addr" size="3"/>
        </pcode>
    </callotherfixup>

    <global>
        <range space="ram"/>
    </global>

    <default_proto>
        <prototype name="__tasking_c166_classic" extrapop="0" stackshift="0">
            <input>
                <!-- Consecutive, unaligned 16-bit argument slots. -->
                <pentry minsize="1" maxsize="2" storage="general">
                    <register name="r12"/>
                </pentry>
                <pentry minsize="1" maxsize="2" storage="general">
                    <register name="r13"/>
                </pentry>
                <pentry minsize="1" maxsize="2" storage="general">
                    <register name="r14"/>
                </pentry>
                <pentry minsize="1" maxsize="2" storage="general">
                    <register name="r15"/>
                </pentry>
                <pentry minsize="1" maxsize="500" align="2">
                    <addr offset="0" space="stack"/>
                </pentry>

                <!-- Only the ellipsis portion of a variadic call is stack-passed. -->
                <rule>
                    <datatype name="any"/>
                    <varargs first="0"/>
                    <goto_stack/>
                    <consume_remaining storage="general"/>
                </rule>

                <!-- TASKING Classic never passes FP values or aggregates in GPRs. -->
                <rule>
                    <datatype name="float"/>
                    <goto_stack/>
                    <consume_remaining storage="general"/>
                </rule>
                <rule>
                    <datatype name="struct"/>
                    <goto_stack/>
                    <consume_remaining storage="general"/>
                </rule>
                <rule>
                    <datatype name="union"/>
                    <goto_stack/>
                    <consume_remaining storage="general"/>
                </rule>

                <!-- 32-bit values consume the next two slots without pair alignment. -->
                <rule>
                    <datatype name="any" maxsize="4"/>
                    <join storage="general" stackspill="false"/>
                </rule>

                <!-- A failed register join spills whole and exhausts the register area. -->
                <rule>
                    <datatype name="any"/>
                    <goto_stack/>
                    <consume_remaining storage="general"/>
                </rule>
            </input>
            <output>
                <pentry minsize="1" maxsize="1">
                    <register name="RL4"/>
                </pentry>
                <pentry minsize="1" maxsize="2">
                    <register name="r4"/>
                </pentry>
                <!-- piece1 is most significant: high R5, low R4. -->
                <pentry minsize="3" maxsize="4">
                    <addr space="join" piece1="r5" piece2="r4"/>
                </pentry>
                <!--
                    Double and structure results live in a caller-visible user-stack
                    block.  The callee returns a near pointer to that block in R4.
                    Keeping a stack entry in this list gives convert_to_ptr the
                    16-bit user-stack address size; the entry is not selected directly.
                -->
                <pentry minsize="5" maxsize="500" align="2">
                    <addr offset="0" space="stack"/>
                </pentry>
                <rule><datatype name="struct"/><convert_to_ptr/></rule>
                <rule><datatype name="union"/><convert_to_ptr/></rule>
                <rule><datatype name="float" minsize="8" maxsize="8"/><convert_to_ptr/></rule>
            </output>
            <unaffected>
                <register name="r0"/>
                <register name="r6"/>
                <register name="r7"/>
                <register name="r8"/>
                <register name="r9"/>
                <register name="DPP0"/>
                <register name="DPP1"/>
                <register name="DPP2"/>
                <register name="DPP3"/>
                <register name="CP"/>
            </unaffected>
            <killedbycall>
                <register name="r1"/>
                <register name="r2"/>
                <register name="r3"/>
                <register name="r4"/>
                <register name="r5"/>
                <register name="r10"/>
                <register name="r11"/>
                <register name="r12"/>
                <register name="r13"/>
                <register name="r14"/>
                <register name="r15"/>
                <register name="PSW"/>
                <register name="MDH"/>
                <register name="MDL"/>
                <register name="MDC"/>
            </killedbycall>
        </prototype>
    </default_proto>

    <!--
        TASKING manual 3.16.5.4: ordinary double-precision runtime routines
        destroy only R1-R5.  In particular they preserve R6-R15 (including
        values parked in R12-R15 between expression-library calls).
    -->
    <prototype name="__tasking_c166_double_runtime" extrapop="0" stackshift="0">
        <input>
            <pentry minsize="1" maxsize="2"><register name="r12"/></pentry>
            <pentry minsize="1" maxsize="2"><register name="r13"/></pentry>
            <pentry minsize="1" maxsize="2"><register name="r14"/></pentry>
            <pentry minsize="1" maxsize="2"><register name="r15"/></pentry>
        </input>
        <output>
            <pentry minsize="1" maxsize="1"><register name="RL4"/></pentry>
            <pentry minsize="1" maxsize="2"><register name="r4"/></pentry>
            <pentry minsize="3" maxsize="4">
                <addr space="join" piece1="r5" piece2="r4"/>
            </pentry>
        </output>
        <unaffected>
            <register name="r0"/>
            <register name="r6"/><register name="r7"/>
            <register name="r8"/><register name="r9"/>
            <register name="r10"/><register name="r11"/>
            <register name="r12"/><register name="r13"/>
            <register name="r14"/><register name="r15"/>
            <register name="DPP0"/><register name="DPP1"/>
            <register name="DPP2"/><register name="DPP3"/>
            <register name="CP"/>
        </unaffected>
        <killedbycall>
            <register name="r1"/><register name="r2"/>
            <register name="r3"/><register name="r4"/><register name="r5"/>
            <register name="PSW"/><register name="MDH"/>
            <register name="MDL"/><register name="MDC"/>
        </killedbycall>
    </prototype>

    <!--
        Call-site-only models used by C166VariadicCallAnalyzer.  The override
        signature is deliberately non-variadic to avoid Ghidra splitting locked
        compound parameters during vararg recovery.  At the first optional
        position these models exhaust the register bank and continue on stack,
        matching the TASKING Classic ABI.
    -->
    <prototype name="__tasking_c166_classic_vararg_1" extrapop="0" stackshift="0">
        <input>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r12"/></pentry>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r13"/></pentry>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r14"/></pentry>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r15"/></pentry>
            <pentry minsize="1" maxsize="500" align="2"><addr offset="0" space="stack"/></pentry>
            <rule>
                <datatype name="any"/>
                <position index="1"/>
                <goto_stack/>
                <consume_remaining storage="general"/>
            </rule>
            <rule><datatype name="float"/><goto_stack/><consume_remaining storage="general"/></rule>
            <rule><datatype name="struct"/><goto_stack/><consume_remaining storage="general"/></rule>
            <rule><datatype name="union"/><goto_stack/><consume_remaining storage="general"/></rule>
            <rule><datatype name="any" maxsize="4"/><join storage="general" stackspill="false"/></rule>
            <rule><datatype name="any"/><goto_stack/><consume_remaining storage="general"/></rule>
        </input>
        <output>
            <pentry minsize="1" maxsize="1"><register name="RL4"/></pentry>
            <pentry minsize="1" maxsize="2"><register name="r4"/></pentry>
            <pentry minsize="3" maxsize="4"><addr space="join" piece1="r5" piece2="r4"/></pentry>
            <pentry minsize="5" maxsize="500" align="2"><addr offset="0" space="stack"/></pentry>
            <rule><datatype name="struct"/><convert_to_ptr/></rule>
            <rule><datatype name="union"/><convert_to_ptr/></rule>
            <rule><datatype name="float" minsize="8" maxsize="8"/><convert_to_ptr/></rule>
        </output>
        <unaffected>
            <register name="r0"/><register name="r6"/><register name="r7"/>
            <register name="r8"/><register name="r9"/>
            <register name="DPP0"/><register name="DPP1"/>
            <register name="DPP2"/><register name="DPP3"/><register name="CP"/>
        </unaffected>
        <killedbycall>
            <register name="r1"/><register name="r2"/><register name="r3"/>
            <register name="r4"/><register name="r5"/>
            <register name="r10"/><register name="r11"/>
            <register name="r12"/><register name="r13"/>
            <register name="r14"/><register name="r15"/>
            <register name="PSW"/><register name="MDH"/>
            <register name="MDL"/><register name="MDC"/>
        </killedbycall>
    </prototype>

    <prototype name="__tasking_c166_classic_vararg_2" extrapop="0" stackshift="0">
        <input>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r12"/></pentry>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r13"/></pentry>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r14"/></pentry>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r15"/></pentry>
            <pentry minsize="1" maxsize="500" align="2"><addr offset="0" space="stack"/></pentry>
            <rule>
                <datatype name="any"/>
                <position index="2"/>
                <goto_stack/>
                <consume_remaining storage="general"/>
            </rule>
            <rule><datatype name="float"/><goto_stack/><consume_remaining storage="general"/></rule>
            <rule><datatype name="struct"/><goto_stack/><consume_remaining storage="general"/></rule>
            <rule><datatype name="union"/><goto_stack/><consume_remaining storage="general"/></rule>
            <rule><datatype name="any" maxsize="4"/><join storage="general" stackspill="false"/></rule>
            <rule><datatype name="any"/><goto_stack/><consume_remaining storage="general"/></rule>
        </input>
        <output>
            <pentry minsize="1" maxsize="1"><register name="RL4"/></pentry>
            <pentry minsize="1" maxsize="2"><register name="r4"/></pentry>
            <pentry minsize="3" maxsize="4"><addr space="join" piece1="r5" piece2="r4"/></pentry>
            <pentry minsize="5" maxsize="500" align="2"><addr offset="0" space="stack"/></pentry>
            <rule><datatype name="struct"/><convert_to_ptr/></rule>
            <rule><datatype name="union"/><convert_to_ptr/></rule>
            <rule><datatype name="float" minsize="8" maxsize="8"/><convert_to_ptr/></rule>
        </output>
        <unaffected>
            <register name="r0"/><register name="r6"/><register name="r7"/>
            <register name="r8"/><register name="r9"/>
            <register name="DPP0"/><register name="DPP1"/>
            <register name="DPP2"/><register name="DPP3"/><register name="CP"/>
        </unaffected>
        <killedbycall>
            <register name="r1"/><register name="r2"/><register name="r3"/>
            <register name="r4"/><register name="r5"/>
            <register name="r10"/><register name="r11"/>
            <register name="r12"/><register name="r13"/>
            <register name="r14"/><register name="r15"/>
            <register name="PSW"/><register name="MDH"/>
            <register name="MDL"/><register name="MDC"/>
        </killedbycall>
    </prototype>

    <prototype name="__tasking_c166_classic_vararg_3" extrapop="0" stackshift="0">
        <input>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r12"/></pentry>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r13"/></pentry>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r14"/></pentry>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r15"/></pentry>
            <pentry minsize="1" maxsize="500" align="2"><addr offset="0" space="stack"/></pentry>
            <rule>
                <datatype name="any"/>
                <position index="3"/>
                <goto_stack/>
                <consume_remaining storage="general"/>
            </rule>
            <rule><datatype name="float"/><goto_stack/><consume_remaining storage="general"/></rule>
            <rule><datatype name="struct"/><goto_stack/><consume_remaining storage="general"/></rule>
            <rule><datatype name="union"/><goto_stack/><consume_remaining storage="general"/></rule>
            <rule><datatype name="any" maxsize="4"/><join storage="general" stackspill="false"/></rule>
            <rule><datatype name="any"/><goto_stack/><consume_remaining storage="general"/></rule>
        </input>
        <output>
            <pentry minsize="1" maxsize="1"><register name="RL4"/></pentry>
            <pentry minsize="1" maxsize="2"><register name="r4"/></pentry>
            <pentry minsize="3" maxsize="4"><addr space="join" piece1="r5" piece2="r4"/></pentry>
            <pentry minsize="5" maxsize="500" align="2"><addr offset="0" space="stack"/></pentry>
            <rule><datatype name="struct"/><convert_to_ptr/></rule>
            <rule><datatype name="union"/><convert_to_ptr/></rule>
            <rule><datatype name="float" minsize="8" maxsize="8"/><convert_to_ptr/></rule>
        </output>
        <unaffected>
            <register name="r0"/><register name="r6"/><register name="r7"/>
            <register name="r8"/><register name="r9"/>
            <register name="DPP0"/><register name="DPP1"/>
            <register name="DPP2"/><register name="DPP3"/><register name="CP"/>
        </unaffected>
        <killedbycall>
            <register name="r1"/><register name="r2"/><register name="r3"/>
            <register name="r4"/><register name="r5"/>
            <register name="r10"/><register name="r11"/>
            <register name="r12"/><register name="r13"/>
            <register name="r14"/><register name="r15"/>
            <register name="PSW"/><register name="MDH"/>
            <register name="MDL"/><register name="MDC"/>
        </killedbycall>
    </prototype>
</compiler_spec>
