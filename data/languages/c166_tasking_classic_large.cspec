<?xml version="1.0" encoding="UTF-8"?>

<!--
    TASKING C166/ST10 Classic ABI, large memory model.

    This compiler spec intentionally lives beside, rather than replacing,
    c166.cspec.  Existing programs using compiler ID "tasking" retain their
    original data organization and calling conventions.
-->
<compiler_spec>
    <stackpointer register="r0" space="ram" growth="negative"/>

    <returnaddress>
        <varnode space="stack" offset="0" size="0"/>
    </returnaddress>

    <!-- TASKING Classic C166 data types, large model. -->
    <data_organization>
        <absolute_max_alignment value="2"/>
        <machine_alignment value="2"/>
        <default_alignment value="1"/>
        <default_pointer_alignment value="2"/>
        <pointer_size value="4"/>
        <char_type signed="true"/>
        <char_size value="1"/>
        <wchar_size value="2"/>
        <short_size value="2"/>
        <integer_size value="2"/>
        <long_size value="4"/>
        <long_long_size value="8"/>
        <float_size value="4"/>
        <double_size value="8"/>
        <long_double_size value="8"/>
        <size_alignment_map>
            <entry size="1" alignment="1"/>
            <entry size="2" alignment="2"/>
            <entry size="4" alignment="2"/>
            <entry size="8" alignment="2"/>
        </size_alignment_map>
    </data_organization>

    <callfixup name="call_far_indirect">
        <target name="__call_far_indirect"/>
        <pcode>
            <body><![CDATA[
            local callAddr:3 = (zext(r5) << 16) | zext(r4);
            call [callAddr];
            ]]></body>
        </pcode>
    </callfixup>

    <callotherfixup targetop="GetPagedOffset">
        <pcode dynamic="true">
            <input name="mem" size="2"/>
            <output name="off" size="3"/>
        </pcode>
    </callotherfixup>

    <callotherfixup targetop="c166_switch_load">
        <pcode dynamic="true">
            <input name="ptr" size="2"/>
            <output name="val" size="2"/>
        </pcode>
    </callotherfixup>

    <callotherfixup targetop="c166_reg_offset_addr">
        <pcode dynamic="true">
            <input name="reg" size="2"/>
            <input name="offset" size="2"/>
            <output name="addr" size="3"/>
        </pcode>
    </callotherfixup>

    <global>
        <range space="ram"/>
    </global>

    <default_proto>
        <prototype name="__tasking_c166_classic" extrapop="0" stackshift="0">
            <input>
                <!-- Consecutive, unaligned 16-bit argument slots. -->
                <pentry minsize="1" maxsize="2" storage="general">
                    <register name="r12"/>
                </pentry>
                <pentry minsize="1" maxsize="2" storage="general">
                    <register name="r13"/>
                </pentry>
                <pentry minsize="1" maxsize="2" storage="general">
                    <register name="r14"/>
                </pentry>
                <pentry minsize="1" maxsize="2" storage="general">
                    <register name="r15"/>
                </pentry>
                <pentry minsize="1" maxsize="500" align="2">
                    <addr offset="0" space="stack"/>
                </pentry>

                <!-- Only the ellipsis portion of a variadic call is stack-passed. -->
                <rule>
                    <datatype name="any"/>
                    <varargs first="0"/>
                    <goto_stack/>
                    <consume_remaining storage="general"/>
                </rule>

                <!-- TASKING Classic never passes FP values or aggregates in GPRs. -->
                <rule>
                    <datatype name="float"/>
                    <goto_stack/>
                    <consume_remaining storage="general"/>
                </rule>
                <rule>
                    <datatype name="struct"/>
                    <goto_stack/>
                    <consume_remaining storage="general"/>
                </rule>
                <rule>
                    <datatype name="union"/>
                    <goto_stack/>
                    <consume_remaining storage="general"/>
                </rule>

                <!-- 32-bit values consume the next two slots without pair alignment. -->
                <rule>
                    <datatype name="any" maxsize="4"/>
                    <join storage="general" stackspill="false"/>
                </rule>

                <!-- A failed register join spills whole and exhausts the register area. -->
                <rule>
                    <datatype name="any"/>
                    <goto_stack/>
                    <consume_remaining storage="general"/>
                </rule>
            </input>
            <output>
                <pentry minsize="1" maxsize="1">
                    <register name="RL4"/>
                </pentry>
                <pentry minsize="1" maxsize="2">
                    <register name="r4"/>
                </pentry>
                <!-- piece1 is most significant: high R5, low R4. -->
                <pentry minsize="3" maxsize="4">
                    <addr space="join" piece1="r5" piece2="r4"/>
                </pentry>
            </output>
            <unaffected>
                <register name="r0"/>
                <register name="r6"/>
                <register name="r7"/>
                <register name="r8"/>
                <register name="r9"/>
                <register name="DPP0"/>
                <register name="DPP1"/>
                <register name="DPP2"/>
                <register name="DPP3"/>
                <register name="CP"/>
            </unaffected>
            <killedbycall>
                <register name="r1"/>
                <register name="r2"/>
                <register name="r3"/>
                <register name="r4"/>
                <register name="r5"/>
                <register name="r10"/>
                <register name="r11"/>
                <register name="r12"/>
                <register name="r13"/>
                <register name="r14"/>
                <register name="r15"/>
                <register name="PSW"/>
                <register name="MDH"/>
                <register name="MDL"/>
                <register name="MDC"/>
            </killedbycall>
        </prototype>
    </default_proto>

    <!--
        Call-site-only models used by C166VariadicCallAnalyzer.  The override
        signature is deliberately non-variadic to avoid Ghidra splitting locked
        compound parameters during vararg recovery.  At the first optional
        position these models exhaust the register bank and continue on stack,
        matching the TASKING Classic ABI.
    -->
    <prototype name="__tasking_c166_classic_vararg_1" extrapop="0" stackshift="0">
        <input>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r12"/></pentry>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r13"/></pentry>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r14"/></pentry>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r15"/></pentry>
            <pentry minsize="1" maxsize="500" align="2"><addr offset="0" space="stack"/></pentry>
            <rule>
                <datatype name="any"/>
                <position index="1"/>
                <goto_stack/>
                <consume_remaining storage="general"/>
            </rule>
            <rule><datatype name="float"/><goto_stack/><consume_remaining storage="general"/></rule>
            <rule><datatype name="struct"/><goto_stack/><consume_remaining storage="general"/></rule>
            <rule><datatype name="union"/><goto_stack/><consume_remaining storage="general"/></rule>
            <rule><datatype name="any" maxsize="4"/><join storage="general" stackspill="false"/></rule>
            <rule><datatype name="any"/><goto_stack/><consume_remaining storage="general"/></rule>
        </input>
        <output>
            <pentry minsize="1" maxsize="1"><register name="RL4"/></pentry>
            <pentry minsize="1" maxsize="2"><register name="r4"/></pentry>
            <pentry minsize="3" maxsize="4"><addr space="join" piece1="r5" piece2="r4"/></pentry>
        </output>
        <unaffected>
            <register name="r0"/><register name="r6"/><register name="r7"/>
            <register name="r8"/><register name="r9"/>
            <register name="DPP0"/><register name="DPP1"/>
            <register name="DPP2"/><register name="DPP3"/><register name="CP"/>
        </unaffected>
        <killedbycall>
            <register name="r1"/><register name="r2"/><register name="r3"/>
            <register name="r4"/><register name="r5"/>
            <register name="r10"/><register name="r11"/>
            <register name="r12"/><register name="r13"/>
            <register name="r14"/><register name="r15"/>
            <register name="PSW"/><register name="MDH"/>
            <register name="MDL"/><register name="MDC"/>
        </killedbycall>
    </prototype>

    <prototype name="__tasking_c166_classic_vararg_2" extrapop="0" stackshift="0">
        <input>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r12"/></pentry>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r13"/></pentry>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r14"/></pentry>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r15"/></pentry>
            <pentry minsize="1" maxsize="500" align="2"><addr offset="0" space="stack"/></pentry>
            <rule>
                <datatype name="any"/>
                <position index="2"/>
                <goto_stack/>
                <consume_remaining storage="general"/>
            </rule>
            <rule><datatype name="float"/><goto_stack/><consume_remaining storage="general"/></rule>
            <rule><datatype name="struct"/><goto_stack/><consume_remaining storage="general"/></rule>
            <rule><datatype name="union"/><goto_stack/><consume_remaining storage="general"/></rule>
            <rule><datatype name="any" maxsize="4"/><join storage="general" stackspill="false"/></rule>
            <rule><datatype name="any"/><goto_stack/><consume_remaining storage="general"/></rule>
        </input>
        <output>
            <pentry minsize="1" maxsize="1"><register name="RL4"/></pentry>
            <pentry minsize="1" maxsize="2"><register name="r4"/></pentry>
            <pentry minsize="3" maxsize="4"><addr space="join" piece1="r5" piece2="r4"/></pentry>
        </output>
        <unaffected>
            <register name="r0"/><register name="r6"/><register name="r7"/>
            <register name="r8"/><register name="r9"/>
            <register name="DPP0"/><register name="DPP1"/>
            <register name="DPP2"/><register name="DPP3"/><register name="CP"/>
        </unaffected>
        <killedbycall>
            <register name="r1"/><register name="r2"/><register name="r3"/>
            <register name="r4"/><register name="r5"/>
            <register name="r10"/><register name="r11"/>
            <register name="r12"/><register name="r13"/>
            <register name="r14"/><register name="r15"/>
            <register name="PSW"/><register name="MDH"/>
            <register name="MDL"/><register name="MDC"/>
        </killedbycall>
    </prototype>

    <prototype name="__tasking_c166_classic_vararg_3" extrapop="0" stackshift="0">
        <input>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r12"/></pentry>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r13"/></pentry>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r14"/></pentry>
            <pentry minsize="1" maxsize="2" storage="general"><register name="r15"/></pentry>
            <pentry minsize="1" maxsize="500" align="2"><addr offset="0" space="stack"/></pentry>
            <rule>
                <datatype name="any"/>
                <position index="3"/>
                <goto_stack/>
                <consume_remaining storage="general"/>
            </rule>
            <rule><datatype name="float"/><goto_stack/><consume_remaining storage="general"/></rule>
            <rule><datatype name="struct"/><goto_stack/><consume_remaining storage="general"/></rule>
            <rule><datatype name="union"/><goto_stack/><consume_remaining storage="general"/></rule>
            <rule><datatype name="any" maxsize="4"/><join storage="general" stackspill="false"/></rule>
            <rule><datatype name="any"/><goto_stack/><consume_remaining storage="general"/></rule>
        </input>
        <output>
            <pentry minsize="1" maxsize="1"><register name="RL4"/></pentry>
            <pentry minsize="1" maxsize="2"><register name="r4"/></pentry>
            <pentry minsize="3" maxsize="4"><addr space="join" piece1="r5" piece2="r4"/></pentry>
        </output>
        <unaffected>
            <register name="r0"/><register name="r6"/><register name="r7"/>
            <register name="r8"/><register name="r9"/>
            <register name="DPP0"/><register name="DPP1"/>
            <register name="DPP2"/><register name="DPP3"/><register name="CP"/>
        </unaffected>
        <killedbycall>
            <register name="r1"/><register name="r2"/><register name="r3"/>
            <register name="r4"/><register name="r5"/>
            <register name="r10"/><register name="r11"/>
            <register name="r12"/><register name="r13"/>
            <register name="r14"/><register name="r15"/>
            <register name="PSW"/><register name="MDH"/>
            <register name="MDL"/><register name="MDC"/>
        </killedbycall>
    </prototype>
</compiler_spec>
